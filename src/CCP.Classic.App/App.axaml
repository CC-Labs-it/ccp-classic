<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CCP.Classic.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#FF69B4</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CCP.Classic.App/Theme.axaml" />
  </Application.Styles>
</Application>
